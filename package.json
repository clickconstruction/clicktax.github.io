{
  "name": "clicktax",
  "private": true,
  "version": "0.1.0",
  "description": "ClickTax: a free, stateless MCP server and web renderer that fills IRS forms. Use at your own risk.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @clicktax/forms && npm run build -w @clicktax/web",
    "test": "npm run test -w @clicktax/forms",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev -w @clicktax/web",
    "dev:mcp": "npm run dev -w @clicktax/mcp",
    "verify:fieldmaps": "tsx tools/verify-fieldmaps.ts",
    "gen:fieldmaps": "tsx tools/gen-fieldmaps.ts",
    "forms:fetch": "node tools/fetch-forms.mjs",
    "forms:dump": "node tools/dump-fields.mjs",
    "forms:draft": "node tools/draft-labels.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  }
}
